NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Family cloud mode is off by default. Configure server secrets outside Git.
# Do not enable this until the new family migration, RLS and device tests pass.
NEXT_PUBLIC_FAMILY_BACKEND=
FAMILY_CLOUD_ENABLED=
SUPABASE_SECRET_KEY=
FAMILY_PIN_PEPPER=
FAMILY_ADMIN_USER_ID=
FAMILY_ADMIN_EMAIL=

# Canonical browser origin used when hosting rewrites the server URL.
NEXT_PUBLIC_APP_ORIGIN=https://ho-am-tieng-anh.netlify.app
